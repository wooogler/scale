{
  "name": "scale",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck -w @scale/web",
    "build": "tsc -b",
    "test": "vitest run",
    "cli": "tsx packages/cli/src/index.ts",
    "dev:web": "npm run dev -w @scale/web",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:map": "node scripts/graphify-check.mjs",
    "pretest": "tsc -b",
    "distill": "node scripts/distill-graph.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=18"
  }
}
